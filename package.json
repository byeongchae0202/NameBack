{
  "name": "nameback",
  "version": "0.1.0",
  "private": true,
  "description": "로컬 MP3 제목 태그 기반 파일명 복원 도구",
  "main": "dist/electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env NAMEBACK_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.electron.json && tsc -p tsconfig.renderer.json",
    "build": "npm run typecheck && vite build && npm run build:main",
    "test": "tsx --test tests/safety.test.ts",
    "start": "electron .",
    "build:sidecar": "pyinstaller --clean --noconfirm --onefile --name nameback-metadata --distpath resources/sidecar --workpath .build/pyinstaller python/metadata_reader.py",
    "package:win": "npm run build:sidecar && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.68.0",
    "@fluentui/react-icons": "^2.0.312",
    "better-sqlite3": "^12.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "6.3.5",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "nanoid@^3.0.0": "3.3.11"
  },
  "build": {
    "appId": "kr.nameback.desktop",
    "productName": "NameBack",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/sidecar/nameback-metadata.exe",
        "to": "nameback-metadata.exe"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}